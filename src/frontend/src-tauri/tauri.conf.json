{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stacks",
  "version": "../package.json",
  "identifier": "io.github.rileyk05.stacks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stacks",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Riley Kehoe",
    "copyright": "Copyright (c) 2026 Riley Kehoe",
    "category": "Education",
    "shortDescription": "A study tool that runs on your own laptop",
    "longDescription": "Stacks answers questions about your course materials with citations to the passages it used, running a small open model on your own machine.",
    "homepage": "https://github.com/RileyK05/Stacks",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
