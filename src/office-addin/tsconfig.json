{
  // Type-checks the pane's JavaScript against Microsoft's Office.js types, so
  // a call to an Office API that doesn't exist fails CI instead of failing in
  // Word, Excel or PowerPoint. Nothing is emitted: the files ship as written.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["office-js"],
    "skipLibCheck": true
  },
  "files": ["public/taskpane.js", "public/bridge.js"]
}
