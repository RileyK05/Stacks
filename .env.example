# Development settings. The desktop app needs none of these: it keeps its
# database and uploads in the per-user app-data directory and configures
# models in Settings (keys go to the OS credential store).

# Where the dev checkout keeps its SQLite database and uploads
# (default: ./data). DATABASE_PATH / STORAGE_ROOT override each part.
# APP_DATA_DIR=./data

# Optional development fallback for the chat model, used only when no
# provider has been chosen in Settings. Any OpenAI-compatible endpoint.
# LLM_BASE_URL=http://127.0.0.1:8081/v1
# LLM_MODEL=minicpm5-2b
# LLM_API_KEY=
